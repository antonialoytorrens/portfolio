<!DOCTYPE html>
<html lang="{{ LANG }}">

<head>
    <meta charset="utf-8">
    <title>{{ TITLE }} | {{ SITE_TITLE }}</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="description" content="{{ DESCRIPTION }}">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="generator" content="blogc {{ BLOGC_VERSION }}">
    <link rel="stylesheet" href="{{ BASE_URL }}/assets/css/reset.css">
    <link rel="stylesheet" href="{{ BASE_URL }}/assets/css/styles.css">
</head>

<body>
  <header>
      <nav>
          <!-- Navigation links -->
          <p>
              <a class="navlink active" href="{{ BASE_URL }}/{{ LANG }}/blog/">Blog</a>
              <span class="cw">&nbsp;|&nbsp;</span>
              <a class="navlink" href="{{ BASE_URL }}/{{ LANG }}/{{ EDUCATION_SLUG }}">{{ EDUCATION_TITLE }}</a>
              <span class="cw">&nbsp;|&nbsp;</span>
              <a class="navlink" href="{{ BASE_URL }}/{{ LANG }}/{{ EXPERIENCE_SLUG }}">{{ EXPERIENCE_TITLE }}</a>
              <span class="cw">&nbsp;|&nbsp;</span>
              <a class="navlink" href="{{ BASE_URL }}/{{ LANG }}/{{ PROJECTS_SLUG }}">{{ PROJECTS_TITLE }}</a>
          </p>
          <!-- Language selection -->
          <p>
              <a class="navlink" href="{{ BASE_URL }}{{ CURRENT_URL_CA }}" class="{% if LANG == "ca" %} active{% endif %}">CA</a>
              <span class="cw">|</span>
              <a class="navlink" href="{{ BASE_URL }}{{ CURRENT_URL_ES }}" class="{% if LANG == "es" %} active{% endif %}">ES</a>
              <span class="cw">|</span>
              <a class="navlink" href="{{ BASE_URL }}{{ CURRENT_URL_EN }}" class="{% if LANG == "en" %} active{% endif %}">EN</a>
          </p>
      </nav>
      <h1>{{ TITLE }}</h1>
  </header>

  <main>
      <article class="post">
          <header class="post-header">
              <time datetime="{{ DATE }}" class="post-date">{{ DATE_FORMATTED }}</time>
              {% ifdef TAGS %}
              <div class="post-tags">
                  {% if LANG == "ca" %}Etiquetes:{% endif %}
                  {% if LANG == "es" %}Etiquetas:{% endif %}
                  {% if LANG == "en" %}Tags:{% endif %}
                  {% foreach TAGS %}
                  <a href="{{ BASE_URL }}/{{ LANG }}/tag/{{ FOREACH_ITEM }}.html" class="tag">{{ FOREACH_ITEM }}</a>
                  {% endforeach %}
              </div>
              {% endif %}
          </header>

          <div class="post-content">
              {{ CONTENT }}
          </div>

          {% ifdef POST_SLUG_ES %}Post en Español: {{ BASE_URL }}/{{ LANG }}/blog/{{ POST_SLUG_ES }}{% endif %}
          {% ifdef POST_SLUG_EN %}Post en Inglés: {{ BASE_URL }}/{{ LANG }}/blog/{{ POST_SLUG_EN }}{% endif %}

          <footer class="post-footer">
              <div class="post-navigation">
                  <a href="{{ BASE_URL }}/{{ LANG }}/blog/" class="back-to-blog">
                      {% if LANG == "ca" %}← Tornar al blog{% endif %}
                      {% if LANG == "es" %}← Volver al blog{% endif %}
                      {% if LANG == "en" %}← Back to blog{% endif %}
                  </a>
              </div>
          </footer>
      </article>
  </main>

  <footer>
      &copy; {{ AUTHOR_NAME }} &middot; Built with blogc
  </footer>

  <style>
    /* Post-specific styles */
    .post {
        max-width: 800px;
        margin: 0 auto;
    }

    .post-header {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #e0e0e0;
    }

    .post-date {
        display: block;
        font-size: 0.9rem;
        color: #888;
        margin-bottom: 1rem;
    }

    .post-tags {
        margin: 1rem 0;
    }

    .tag {
        display: inline-block;
        background: #f0f0f0;
        color: #666;
        padding: 0.3rem 0.6rem;
        margin: 0 0.5rem 0.5rem 0;
        border-radius: 4px;
        text-decoration: none;
        font-size: 0.85rem;
        transition: all 0.2s ease;
    }

    .tag:hover {
        background: #005ED9;
        color: white;
    }

    .post-content {
        line-height: 1.6;
        margin-bottom: 3rem;
    }

    .post-content h1,
    .post-content h2,
    .post-content h3,
    .post-content h4,
    .post-content h5,
    .post-content h6 {
        margin: 2rem 0 1rem 0;
        color: #333;
    }

    .post-content h1 { font-size: 2rem; }
    .post-content h2 { font-size: 1.75rem; }
    .post-content h3 { font-size: 1.5rem; }
    .post-content h4 { font-size: 1.25rem; }

    .post-content p {
        margin-bottom: 1rem;
    }

    .post-content ul,
    .post-content ol {
        margin: 1rem 0;
        padding-left: 2rem;
    }

    .post-content li {
        margin-bottom: 0.5rem;
    }

    .post-content blockquote {
        margin: 1.5rem 0;
        padding: 1rem 1.5rem;
        border-left: 4px solid #005ED9;
        background: #f8f9fa;
        font-style: italic;
    }

    .post-content pre {
        margin: 1.5rem 0;
        padding: 1rem;
        background: #f8f8f8;
        border-radius: 4px;
        overflow-x: auto;
    }

    .post-content code {
        background: rgba(0, 0, 0, 0.1);
        padding: 0.2rem 0.4rem;
        border-radius: 3px;
        font-family: "Fira Code VF", monospace;
    }

    .post-content pre code {
        background: none;
        padding: 0;
    }

    .post-footer {
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid #e0e0e0;
    }

    .back-to-blog {
        display: inline-block;
        color: #005ED9;
        text-decoration: none;
        font-weight: bold;
    }

    .back-to-blog:hover {
        color: #0000EE;
        text-decoration: underline;
    }

    @media (max-width: 768px) {
        main {
            margin: 0.5rem;
        }
        
        .post {
            max-width: none;
        }
    }
  </style>
</body>

</html>