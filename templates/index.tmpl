<!DOCTYPE html>
<html lang="{{ LANG }}">

<head>
    <meta charset="utf-8">
    <title>{{ TITLE }} | {{ SITE_TITLE }}</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="description" content="{{ DESCRIPTION }}">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="generator" content="blogc {{ BLOGC_VERSION }}">
    <link rel="stylesheet" href="{{ BASE_URL }}/assets/css/reset.css">
    <link rel="stylesheet" href="{{ BASE_URL }}/assets/css/styles.css">
    <link rel="stylesheet" href="{{ BASE_URL }}/assets/css/posts.css">
</head>

<body>
    <header>
        <nav>
            <!-- Navigation links -->
            <p>
                <a class="navlink {% if PAGE_SLUG == URL_BLOG %}active{% else %} {% if CURRENT_URL_KEY == "blog" %}active{% endif %}{% endif %}" href="{{ BASE_URL }}{{ URL_BLOG }}">Blog</a>
                <span class="cw">&nbsp;|&nbsp;</span>
                <a class="navlink {% if PAGE_SLUG == URL_EDUCATION %}active{% endif %}" href="{{ BASE_URL }}{{ URL_EDUCATION }}">{% if LANG == "ca" %}Educació{% endif %}{% if LANG == "en" %}Education{% endif %}{% if LANG == "es" %}Educación{% endif %}</a>
                <span class="cw">&nbsp;|&nbsp;</span>
                <a class="navlink {% if PAGE_SLUG == URL_ABOUT %}active{% endif %}" href="{{ BASE_URL }}{{ URL_ABOUT }}">{% if LANG == "ca" %}Sobre{% endif %}{% if LANG == "en" %}About{% endif %}{% if LANG == "es" %}Acerca{% endif %}</a>
                <span class="cw">&nbsp;|&nbsp;</span>
                <a class="navlink {% if PAGE_SLUG == URL_SERVICES %}active{% endif %}" href="{{ BASE_URL }}{{ URL_SERVICES }}">{% if LANG == "ca" %}Serveis{% endif %}{% if LANG == "en" %}Services{% endif %}{% if LANG == "es" %}Servicios{% endif %}</a>
                <span class="cw">&nbsp;|&nbsp;</span>
                <a class="navlink {% if PAGE_SLUG == URL_CONTACT %}active{% endif %}" href="{{ BASE_URL }}{{ URL_CONTACT }}">{% if LANG == "ca" %}Contacte{% endif %}{% if LANG == "en" %}Contact{% endif %}{% if LANG == "es" %}Contacto{% endif %}</a>
            </p>
            <!-- Language selection -->
            <p>
                <a class="navlink" href="{{ BASE_URL }}{{ CURRENT_URL_CA }}" class="{% if LANG == "ca" %} active{% endif %}">CA</a>
                <span class="cw">|</span>
                <a class="navlink" href="{{ BASE_URL }}{{ CURRENT_URL_ES }}" class="{% if LANG == "es" %} active{% endif %}">ES</a>
                <span class="cw">|</span>
                <a class="navlink" href="{{ BASE_URL }}{{ CURRENT_URL_EN }}" class="{% if LANG == "en" %} active{% endif %}">EN</a>
            </p>
        </nav>
        <h1>{% ifdef MAIN_PAGE %}{{ MAIN_PAGE }}{% else %}{{ TITLE }}{% endif %}</h1>
    </header>

    <main>
        <!-- Main page content -->
        {% block listing_entry %}
            <section class="main-content">
                {{ CONTENT }}
            </section>
        {% endblock %}

        <!-- Latest blog posts section -->
        {% block listing_once %}
            {% ifdef FILENAME_FIRST %}
                <section class="latest-posts">
                    <h2>
                        {% if LANG == "ca" %}Últimes entrades{% endif %}
                        {% if LANG == "es" %}Últimas entradas{% endif %}
                        {% if LANG == "en" %}Latest posts{% endif %}
                    </h2>
                    <ul class="posts-list">
            {% endif %}
        {% endblock %}

        {% block listing %}
            <li class="post-item">
                <article>
                    <header>
                        <h3><a href="{{ BASE_URL }}blog/post/{{ FILENAME }}.html">{{ TITLE }}</a></h3>
                        <!-- FILENAME_10: pick the 10 first characters of the blog filename, which represents the post publication date. -->
                        <time datetime="{{ FILENAME_10 }}">{{ FILENAME_10 }}</time>
                        {% ifdef TAGS %}
                            <div class="post-tags">
                                {% if LANG == "ca" %}Etiquetes:{% endif %}
                                {% if LANG == "es" %}Etiquetas:{% endif %}
                                {% if LANG == "en" %}Tags:{% endif %}
                                {% foreach TAGS %}
                                    <a href="{{ BASE_URL }}/{{ LANG }}/tag/{{ FOREACH_ITEM }}.html" class="tag">{{ FOREACH_ITEM }}</a>
                                {% endforeach %}
                            </div>
                        {% endif %}
                    </header>
                    {% ifdef DESCRIPTION %}
                        <div class="post-excerpt">
                            <p>{{ DESCRIPTION }}</p>
                        </div>
                    {% endif %}
                </article>
            </li>
        {% endblock %}

        {% block listing_once %}
            {% ifdef FILENAME_FIRST %}
                    </ul>
                    <div class="view-all-posts">
                        <a href="{{ BASE_URL }}blog/" class="btn">
                            {% if LANG == "ca" %}Veure totes les entrades{% endif %}
                            {% if LANG == "es" %}Ver todas las entradas{% endif %}
                            {% if LANG == "en" %}View all posts{% endif %}
                        </a>
                    </div>
            {% endif %}
                </section>
        {% endblock %}

        {% block listing_empty %}
            Not available
        {% endblock %}

        {% block entry %}
            {{ CONTENT }}
        {% endblock %}
    </main>

    <footer>
        &copy; {{ AUTHOR_NAME }} &middot; Built with blogc
    </footer>
</body>

</html>
