<!DOCTYPE html>
<html lang="{{ LANG }}">
<head>
    <meta charset="utf-8">
    <title>{{ SITE_TITLE }}</title>
    <meta name="description" content="{{ SITE_TAGLINE }}">
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body>
    <!-- Dynamic language switcher using mapping variables -->
    <nav class="language-switcher">
        <h3>
            Idioma: "{{ LANG }}"
        </h3>
        <ul>
            {% ifdef CURRENT_URL_CA %}<li><a href="{{ CURRENT_URL_CA }}" {% if LANG == ca %}class="current"{% endif %}>Català</a></li>{% endif %}
            {% ifdef CURRENT_URL_EN %}<li><a href="{{ CURRENT_URL_EN }}" {% if LANG == "en" %}class="current"{% endif %}>English</a></li>{% endif %}
            {% ifdef CURRENT_URL_ES %}<li><a href="{{ CURRENT_URL_ES }}" {% if LANG == "es" %}class="current"{% endif %}>Español</a></li>{% endif %}
            {% ifdef CURRENT_URL_FR %}<li><a href="{{ CURRENT_URL_FR }}" {% if LANG == "fr" %}class="current"{% endif %}>Français</a></li>{% endif %}
            {% ifdef CURRENT_URL_DE %}<li><a href="{{ CURRENT_URL_DE }}" {% if LANG == "de" %}class="current"{% endif %}>Deutsch</a></li>{% endif %}
        </ul>
    </nav>

    <!-- Main navigation using translation keys -->
    <nav class="main-menu">
        <ul>
            <li><a href="/{{ LANG }}/{{ KEY_EDUCATION }}">
                {% if LANG == "ca" %}Educació{% endif %}
                {% if LANG == "en" %}Education{% endif %}
                {% if LANG == "es" %}Educación{% endif %}
                {% if LANG == "fr" %}Éducation{% endif %}
                {% if LANG == "de" %}Bildung{% endif %}
            </a></li>
            <li><a href="/{{ LANG }}/{{ KEY_ABOUT }}">
                {% if LANG == "ca" %}Sobre{% endif %}
                {% if LANG == "en" %}About{% endif %}
                {% if LANG == "es" %}Acerca{% endif %}
                {% if LANG == "fr" %}À propos{% endif %}
                {% if LANG == "de" %}Über{% endif %}
            </a></li>
            <li><a href="/{{ LANG }}/{{ KEY_CONTACT }}">
                {% if LANG == "ca" %}Contacte{% endif %}
                {% if LANG == "en" %}Contact{% endif %}
                {% if LANG == "es" %}Contacto{% endif %}
                {% if LANG == "fr" %}Contact{% endif %}
                {% if LANG == "de" %}Kontakt{% endif %}
            </a></li>
            <li><a href="/{{ LANG }}/{{ KEY_SERVICES }}">
                {% if LANG == "ca" %}Serveis{% endif %}
                {% if LANG == "en" %}Services{% endif %}
                {% if LANG == "es" %}Servicios{% endif %}
                {% if LANG == "fr" %}Services{% endif %}
                {% if LANG == "de" %}Dienstleistungen{% endif %}
            </a></li>
            <li><a href="/{{ LANG }}/{{ KEY_PORTFOLIO }}">
                {% if LANG == "ca" %}Portafoli{% endif %}
                {% if LANG == "en" %}Portfolio{% endif %}
                {% if LANG == "es" %}Portafolio{% endif %}
                {% if LANG == "fr" %}Portfolio{% endif %}
                {% if LANG == "de" %}Portfolio{% endif %}
            </a></li>
            <li><a href="/{{ LANG }}/{{ KEY_BLOG }}">Blog</a></li>
        </ul>
    </nav>

    <main>
        <h1>{{ TITLE }}</h1>

        <article>
            {{ CONTENT }}
        </article>

        <aside class="debug-info">
            <h3>Translation Debug Info:</h3>
            <p><strong>Current page key:</strong> {{ KEY_EDUCATION }}</p>
            <p><strong>Available versions:</strong></p>
            <ul>
                {% ifdef KEY_EDUCATION_CA %}<li>Catalan: <code>{{ KEY_EDUCATION_CA }}</code> → <a href="{{ CURRENT_URL_CA }}">{{ CURRENT_URL_CA }}</a></li>{% endif %}
                {% ifdef KEY_EDUCATION_EN %}<li>English: <code>{{ KEY_EDUCATION_EN }}</code> → <a href="{{ CURRENT_URL_EN }}">{{ CURRENT_URL_EN }}</a></li>{% endif %}
                {% ifdef KEY_EDUCATION_ES %}<li>Spanish: <code>{{ KEY_EDUCATION_ES }}</code> → <a href="{{ CURRENT_URL_ES }}">{{ CURRENT_URL_ES }}</a></li>{% endif %}
                {% ifdef KEY_EDUCATION_FR %}<li>French: <code>{{ KEY_EDUCATION_FR }}</code> → <a href="{{ CURRENT_URL_FR }}">{{ CURRENT_URL_FR }}</a></li>{% endif %}
                {% ifdef KEY_EDUCATION_DE %}<li>German: <code>{{ KEY_EDUCATION_DE }}</code> → <a href="{{ CURRENT_URL_DE }}">{{ CURRENT_URL_DE }}</a></li>{% endif %}
            </ul>
        </aside>
    </main>

    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            line-height: 1.6;
            margin: 0;
            padding: 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .language-switcher {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 2rem;
        }

        .language-switcher h3 {
            margin: 0 0 1rem 0;
            font-size: 0.9rem;
            color: #6c757d;
        }

        .language-switcher ul {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .language-switcher a {
            text-decoration: none;
            padding: 0.5rem 1rem;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            background: white;
            color: #495057;
            font-size: 0.9rem;
            transition: all 0.2s;
        }

        .language-switcher a:hover {
            border-color: #007cba;
            color: #007cba;
        }

        .language-switcher a.current {
            background: #007cba;
            color: white;
            border-color: #007cba;
        }

        .main-menu {
            margin: 2rem 0;
            border-bottom: 1px solid #e9ecef;
            padding-bottom: 1rem;
        }

        .main-menu ul {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            gap: 2rem;
            flex-wrap: wrap;
        }

        .main-menu a {
            text-decoration: none;
            font-weight: 600;
            color: #212529;
            padding: 0.5rem 0;
            border-bottom: 2px solid transparent;
            transition: border-color 0.2s;
        }

        .main-menu a:hover {
            border-bottom-color: #007cba;
        }

        .debug-info {
            margin-top: 3rem;
            padding: 1rem;
            background: #f8f9fa;
            border-left: 4px solid #007cba;
            font-size: 0.9rem;
        }

        .debug-info h3 {
            margin-top: 0;
            color: #007cba;
        }

        .debug-info ul {
            margin: 0.5rem 0;
        }

        .debug-info code {
            background: #e9ecef;
            padding: 0.2rem 0.4rem;
            border-radius: 3px;
            font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;
        }

        @media (max-width: 768px) {
            body {
                padding: 1rem;
            }

            .language-switcher ul,
            .main-menu ul {
                flex-direction: column;
                gap: 0.5rem;
            }

            .main-menu ul {
                gap: 1rem;
            }
        }
    </style>
</body>
</html>
